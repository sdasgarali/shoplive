# ── Database ──────────────────────────────────────────────────────────────
# Local dev default is SQLite (no config needed). For Postgres / docker-compose:
POSTGRES_USER=shoplive
POSTGRES_PASSWORD=shoplive
POSTGRES_DB=shoplive
# The backend reads DATABASE_URL directly; compose builds it from the above.
# DATABASE_URL=postgresql+psycopg://shoplive:shoplive@localhost:5432/shoplive

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Realtime (future: cross-process pub/sub) ───────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Later / paid services (not needed for MVP) ─────────────────────────────
# STRIPE_SECRET_KEY=            # payments (checkout, marketplace payouts)
# MUX_TOKEN_ID=                 # live video ingest (RTMP -> HLS)
# MUX_TOKEN_SECRET=
# S3_BUCKET= / S3_ACCESS_KEY=   # product image / media storage
